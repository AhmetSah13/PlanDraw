{
  "name": "plandraw",
  "private": true,
  "description": "PlanDraw — Backend + Frontend tek komutla dev",
  "scripts": {
    "dev": "concurrently -n BACKEND,FRONTEND -c green,blue \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "cd backend && python -m uvicorn app.api.main:app --reload --port 8000",
    "dev:frontend": "cd webapp/operator-v2 && npm run dev -- --host 127.0.0.1 --port 5173",
    "dev:frontend:v3": "cd webapp/operator-v3 && npm run dev -- --host 127.0.0.1 --port 5174",
    "dev:v3": "concurrently -n BACKEND,V3 -c green,magenta \"npm:dev:backend\" \"npm:dev:frontend:v3\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
