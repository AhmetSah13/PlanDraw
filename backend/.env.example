# Seri port canlı gönderim (POST /api/execute_serial, dry_run=false için SERIAL_PORT zorunlu)
SERIAL_PORT=
SERIAL_BAUD=115200

# false: yalnızca loopback istemciler; true: IP localhost filtresi kalkar (dikkat)
EXECUTE_SERIAL_ALLOW_REMOTE=false

# Boş bırakılırsa token zorunluluğu yok; doluysa her istekte X-Execute-Token başlığı gerekir
EXECUTE_SERIAL_ADMIN_TOKEN=
